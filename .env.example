# Server variables only. Never prefix these with VITE_ or put values in client code.
NODE_ENV=development
PORT=3001
# Comma-separated frontend origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to the verified number of reverse-proxy hops on your hosting provider.
# TRUST_PROXY=1

# Leave SMTP blank for development-only console logging. Production requires SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM=
CONTACT_TO=

# Optional additional notification after email succeeds.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public build settings (never place credentials in VITE_ variables).
# Empty API URL uses same-origin /api via the Vite proxy or production Express server.
# For a split deployment, use the HTTPS backend origin, e.g. https://blue-api.example.com.
VITE_API_URL=
# Replace before generating production sitemap/robots and canonical metadata.
SITE_URL=https://example.com
VITE_SITE_URL=
